#!/usr/bin/make -f

export PYBUILD_NAME=furiusisomount

%:
	dh $@ --with python3 --buildsystem=pybuild

# Upstream tests do not need Qt; keep the build honest and fast.
override_dh_auto_test:
	python3 tests/test_core.py

# Install the upstream changelog under its canonical name so that
# /usr/share/doc/furiusisomount/changelog.gz exists (policy 12.7).
override_dh_installdocs:
	dh_installdocs
	install -m 0644 CHANGELOG.md debian/furiusisomount/usr/share/doc/furiusisomount/changelog
